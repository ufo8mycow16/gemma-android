#!/usr/bin/env python3
"""Stand-in for the Claude Code CLI: speaks its stream-json output and really edits a file, like the real one would."""
import json, os, sys, time
args = sys.argv[1:]
if "--version" in args:
    print("9.9.9 (Claude Code stub)"); sys.exit(0)
prompt = args[args.index("-p") + 1]
def out(o):
    print(json.dumps(o), flush=True)
out({"type": "system", "subtype": "init", "session_id": "stub-session-1", "cwd": os.getcwd()})
review = "--permission-mode" in args and args[args.index("--permission-mode") + 1] == "plan"
target = next((f for f in os.listdir(".") if f.endswith(".py")), None)
out({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": "Read", "input": {"file_path": os.path.abspath(target or "x")}}]}})
time.sleep(0.2)
if not review and target:
    src = open(target).read()
    open(target, "w").write(src.replace("return a - b", "return a + b"))
    out({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": "Edit", "input": {"file_path": os.path.abspath(target)}}]}})
    out({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": "Bash", "input": {"command": "python3 -m pytest -q"}}]}})
time.sleep(0.2)
summary = ("Review: the add() function now returns a + b, which is correct." if review else
           "Fixed add() in calc.py (it subtracted). Ran pytest: 1 passed.")
out({"type": "result", "subtype": "success", "is_error": False, "result": summary, "num_turns": 3, "total_cost_usd": 0.01,
     "session_id": "stub-session-1", "brief_chars": len(prompt)})
